{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "matchmaking": {
      ".read": "auth != null",
      ".indexOn": ["rating", "timestamp", "joinedAt"],
      "$uid": {
        ".write": "auth != null && (auth.uid === $uid || (data.exists() && (data.child('status').val() === 'waiting' || data.child('hostUid').val() === auth.uid) && (newData.child('hostUid').val() === auth.uid || !newData.child('hostUid').exists())))"
      }
    },
    "arena_matchmaking": {
      ".read": "auth != null",
      ".indexOn": ["wins", "timestamp", "joinedAt"],
      "$uid": {
        ".write": "auth != null && (auth.uid === $uid || (data.exists() && (data.child('status').val() === 'waiting' || data.child('hostUid').val() === auth.uid) && (newData.child('hostUid').val() === auth.uid || !newData.child('hostUid').exists())))"
      }
    },
    "rooms": {
      ".read": "auth != null",
      "$roomId": {
        ".write": "auth != null && ((!data.exists() && (newData.child('matchmaking/hostUid').val() === auth.uid || newData.child('players/host/uid').val() === auth.uid)) || (data.exists() && (data.child('matchmaking/hostUid').val() === auth.uid || data.child('matchmaking/guestUid').val() === auth.uid || data.child('players/host/uid').val() === auth.uid || data.child('players/guest/uid').val() === auth.uid || (data.child('status').val() === 'waiting' && !data.child('players/guest').exists() && newData.child('players/guest/uid').val() === auth.uid))))"
      }
    },
    "rankings": {
      "global": {
        ".read": "auth != null",
        ".indexOn": ["rating", "updatedAt", "dailyWins", "dailyWinDate", "highestEndlessScore"],
        "$uid": {
          ".write": "auth != null && (auth.uid === $uid || (!newData.exists() && data.child('publicId').exists() && data.child('publicId').val() === root.child('rankings/global/' + auth.uid + '/publicId').val()))"
        }
      }
    },
    "rankedSeasons": {
      ".read": "auth != null",
      "currentSeasonId": {
        ".write": "auth != null"
      },
      "seasons": {
        "$seasonId": {
          "rankings": {
            ".indexOn": ["rating", "updatedAt", "dailyWins", "dailyWinDate", "highestEndlessScore"],
            "$uid": {
              ".write": "auth != null && auth.uid === $uid"
            }
          },
          "finalTop100": {
            ".write": "auth != null"
          },
          "finalized": {
            ".write": "auth != null"
          },
          "finalizedAt": {
            ".write": "auth != null"
          }
        }
      }
    },
    "rankedSeasonBadges": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null"
      }
    },
    "serverTimePings": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "appConfig": {
      ".read": true,
      ".write": false
    },
    "playerRecordSummaries": {
      ".read": "auth != null",
      ".indexOn": ["publicId", "displayName", "updatedAt", "recordDate"],
      "$uid": {
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "playerNameLookup": {
      ".read": "auth != null",
      "$name": {
        "$uid": {
          ".write": "auth != null && auth.uid === $uid"
        }
      }
    },
    "reports": {
      ".read": false,
      ".indexOn": ["reportedUid", "createdAt"],
      "$reportId": {
        ".write": "auth != null && !data.exists() && newData.child('reporterUid').val() === auth.uid"
      }
    },
    "giftCodes": {
      "adRemoval": {
        ".read": false,
        "$code": {
          ".write": false
        }
      }
    }
  }
}
