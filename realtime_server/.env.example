NODE_ENV=production
HOST=0.0.0.0
PORT=8080
ALLOW_UNVERIFIED_DEV_TOKENS=false
FIREBASE_SERVICE_ACCOUNT_PATH=/opt/hexagon-realtime/service-account.json
PING_INTERVAL_MS=5000
ROOM_IDLE_TTL_MS=60000
MAX_MESSAGE_BYTES=65536

# Optional. Leave empty to disable /metrics in production.
# Set this and access /metrics?token=YOUR_TOKEN when measuring live traffic.
METRICS_TOKEN=
