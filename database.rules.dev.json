{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      ".read": true,
      ".write": true
    },
    "matchmaking": {
      ".read": true,
      ".write": true,
      ".indexOn": ["rating", "timestamp", "assignedAt", "joinedAt", "createdAt"]
    },
    "arena_matchmaking": {
      ".read": true,
      ".write": true,
      ".indexOn": ["wins", "timestamp", "assignedAt", "joinedAt", "createdAt"]
    },
    "rooms": {
      ".read": true,
      ".write": true,
      ".indexOn": ["updatedAt", "resultKnownAt", "startedAt", "createdAt", "matchmaking/timestamp"]
    },
    "rankings": {
      "global": {
        ".read": false,
        ".write": true
      }
    },
    "endlessAllTimeRankings": {
      ".read": true,
      ".write": true,
      ".indexOn": ["highestEndlessScore", "updatedAt"]
    },
    "rankedSeasons": {
      ".read": true,
      "currentSeasonId": {
        ".write": false
      },
      "archivedSeasonIds": {
        ".write": false
      },
      "seasons": {
        "$seasonId": {
          "rankings": {
            ".indexOn": ["rating", "updatedAt", "dailyWins", "dailyWinDate", "previousDailyWinDate", "highestEndlessScore"],
            "$uid": {
              ".write": true
            }
          },
          "finalTop100": {
            ".write": false
          },
          "finalTop100SchemaVersion": {
            ".write": false
          },
          "finalized": {
            ".write": false
          },
          "finalizedAt": {
            ".write": false
          }
        }
      }
    },
    "rankedSeasonBadges": {
      ".read": false,
      ".write": false
    },
    "rankedSeasonRankBadges": {
      ".read": true,
      ".write": false
    },
    "endlessSeasonRankBadges": {
      ".read": true,
      ".write": false
    },
    "endlessSeasons": {
      ".read": true,
      ".write": true,
      "seasons": {
        "$seasonId": {
          "rankings": {
            ".indexOn": ["highestEndlessScore", "updatedAt"]
          }
        }
      }
    },
    "serverTimePings": {
      ".read": true,
      ".write": true,
      ".indexOn": ["current/timestamp"]
    },
    "realtimeGameActivity": {
      ".read": true,
      ".write": true,
      ".indexOn": ["mode", "updatedAt", "enteredAt"]
    },
    "appConfig": {
      ".read": true,
      ".write": true
    },
    "adminStats": {
      ".read": true,
      ".write": true
    },
    "adminGrants": {
      ".read": true,
      ".write": true
    },
    "adminGrantExpirations": {
      ".read": true,
      ".write": true,
      ".indexOn": ["expiresAt"]
    },
    "inviteCodes": {
      ".read": true,
      ".write": true,
      ".indexOn": ["uid", "updatedAt"]
    },
    "inviteClaims": {
      ".read": true,
      ".write": true
    },
    "inviteCompletions": {
      ".read": true,
      ".write": true
    },
    "playerRecordSummaries": {
      ".read": true,
      ".write": true,
      ".indexOn": ["publicId", "displayName", "updatedAt", "recordDate"]
    },
    "publicProfiles": {
      ".read": true,
      ".write": true,
      ".indexOn": ["publicId", "displayName", "updatedAt"]
    },
    "dailyGlobalStats": {
      ".read": true,
      ".write": true
    },
    "playerNameLookup": {
      ".read": true,
      ".write": true
    },
    "reports": {
      ".read": false,
      ".write": true,
      ".indexOn": ["reportedUid", "createdAt"]
    },
    "giftCodes": {
      "adRemoval": {
        ".read": false,
        "$code": {
          ".write": false
        }
      }
    }
  }
}
